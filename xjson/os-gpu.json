{
  "id": "asxr-gpu-runtime",
  "version": "4.0.0",
  "codename": "Vector Dominance",
  "name": "ASXR-GPU Runtime",
  "type": "asxr-gpu-accelerated",
  "philosophy": "GPU-first computing with K'UHUL vector language, WebGL/WebGPU acceleration, neural vector operations",
  "features": [
    "kuhul-svg-3d-language",
    "webgl-webgpu-acceleration",
    "asc-cipher-encryption",
    "scx-vector-compression",
    "neural-vector-operations",
    "3d-control-flow",
    "asxr-browser-vm",
    "gpu-shader-compilation",
    "real-time-rendering",
    "vector-cryptography"
  ],
  "gpu_capabilities": {
    "webgl": true,
    "webgpu": true,
    "compute_shaders": true,
    "neural_inference": true,
    "vector_processing": true
  },
  "kuhul_language": {
    "version": "1.0.0",
    "glyphs": {
      "asc_cipher": ["(⤍)", "(⤎)", "(⤏)", "(⤐)"],
      "scx_compression": ["(↻)", "(↔)", "(⤒)", "(⤓)"],
      "3d_control": ["(⟲)", "(⤦)", "(⤧)", "(⤨)"],
      "neural_ops": ["(⟿)", "(⤂)", "(⤃)", "(⤄)"]
    }
  },
  "modules": {
    "gpu_core": [
      "/gpu/webgl-engine.js",
      "/gpu/webgpu-engine.js",
      "/gpu/shaders.js"
    ],
    "vector_language": [
      "/kuhul/svg-3d-runtime.js",
      "/kuhul/asc-cipher.js",
      "/kuhul/scx-compression.js"
    ],
    "neural_ops": [
      "/vector/neural-processor.js",
      "/vector/tensor-ops.js"
    ]
  }
}
